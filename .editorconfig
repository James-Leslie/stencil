# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches prettier's defaults for the web half.
[*.{js,ts,svelte,json,jsonc,yml,yaml,toml,md,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
